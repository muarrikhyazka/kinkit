<?xml version="1.0" encoding="UTF-8"?>
<!-- Samsung Tizen TV web app config. Package with Tizen Studio (see tv/README.md).
     Replace "AbCdEf1234" with your own 10-character package id if you have one. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://kinkit.app/tv" version="1.2.0" viewmodes="maximized">
    <tizen:application id="AbCdEf1234.KinkitTV" package="AbCdEf1234" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Kinkit TV</name>
    <description>View-only Kinkit family finance dashboard.</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <!-- Network access to your Kinkit server (any origin, since it is self-hosted). -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:content-security-policy>default-src 'self'; connect-src *; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'</tizen:content-security-policy>
</widget>
